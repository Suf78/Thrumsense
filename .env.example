# =============================================================================
# Thrumsense — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
#   cp .env.example .env
#
# NEVER commit .env to git — it is listed in .gitignore.
# All defaults below work out-of-the-box when MongoDB + Redis are started
# with:  docker compose up -d
# =============================================================================


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------

# Full MongoDB connection URI.
# Default: local Docker container started by docker-compose.yml.
# For a remote Atlas cluster (free tier available): mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# Name of the MongoDB database to use.
# All collections (readings, alerts, benchmarks) are created here automatically.
MONGO_DB=thrumsense


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection URL.
# Format:  redis://[password@]host:port/db_number
# Default: local Docker container on db 0.
# If Redis is unavailable, the app falls back to MongoDB gracefully
# and shows a "cache offline" badge — it will NOT crash.
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# How long (in seconds) to keep cached query results in Redis before re-fetching.
# Lower = fresher data but more DB load.
# Higher = faster dashboard but slightly stale aggregates.
# Applies to: latest:{sensor}, stats:{sensor}:*, health score.
CACHE_TTL_SECONDS=60


# -----------------------------------------------------------------------------
# Replay Engine
# -----------------------------------------------------------------------------

# Run the replay worker as a background thread inside the Dash process.
# true  → single process, easiest for demos (default).
# false → run replay as a separate process:  python -m app.replay
REPLAY_IN_PROCESS=true

# Default playback speed multiplier when the app starts.
# 1  = 1 simulated hour advances every real second (slowest, good for watching)
# 10 = 1 hour every 0.1 s  (fast demo mode)
# 60 = 1 hour every ~17 ms (maximum speed, data-loading stress test)
REPLAY_SPEED=1


# -----------------------------------------------------------------------------
# Dataset
# -----------------------------------------------------------------------------

# Path to the UCI Air Quality CSV file, relative to the project root.
# Download from: https://archive.ics.uci.edu/dataset/360/air+quality
# The file uses semicolon (;) separators and decimal commas — ingest.py handles both.
# DO NOT change the filename convention; keep it as AirQualityUCI.csv.
DATA_PATH=data/AirQualityUCI.csv


# -----------------------------------------------------------------------------
# Benchmark Lab
# -----------------------------------------------------------------------------

# Number of timed iterations per query × condition combination.
# 5 warm-up runs are always discarded before these N timed runs.
# Lower = faster benchmark run; higher = more stable statistics (mean/median/p95).
BENCHMARK_N=50

# Whether to also run the benchmark on a synthetic scaled copy of the data
# (x50 duplicates with shifted timestamps, clearly labelled synthetic).
# Useful if 9,358 rows show only tiny latency differences.
# true / false
BENCHMARK_SCALED=false


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Python logging level for the application.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG shows every cache hit/miss and every alert emitted.
# INFO is recommended for demos.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------

# Host and port for the Dash development server.
# Use 0.0.0.0 to expose on the local network (e.g. for projector demo).
DASH_HOST=127.0.0.1
DASH_PORT=8050

# Set to true to enable Dash hot-reload (development only).
# Set to false for a cleaner demo (no browser auto-refresh).
DASH_DEBUG=false


# -----------------------------------------------------------------------------
# Notes on free services used
# -----------------------------------------------------------------------------
# MongoDB 7  — free, self-hosted via Docker (mongo:7 image)
# Redis 7    — free, self-hosted via Docker (redis:7-alpine image)
# Python pkgs — all open-source, listed in requirements.txt
# Dataset    — public domain, UCI ML Repository
# Fonts      — Google Fonts (Space Grotesk, Inter, JetBrains Mono), free
# No paid APIs, no cloud billing, no account required.
# =============================================================================
