# Datasets and benchmark outputs (AGENTS.md rule 10)
# Ignore the data folder contents but keep the placeholder so the folder
# exists in git after a fresh clone (allows 'python -m app.ingest' to work).
data/*.csv
data/*.xlsx
data/*.zip
data/scaled_*.csv
data/benchmark_*.csv
!data/.gitkeep

# Benchmark result dumps (generated at runtime, not source of truth)
benchmark_dumps/
*.dump

